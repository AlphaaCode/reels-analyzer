# Reels Analyzer — the whole pipeline is free.
# Provider order: open model (below) -> Gemini -> heuristic signals-only.

# ---- Open-source model (primary) ----------------------------------------
# Any OpenAI-compatible endpoint serving an open-weight VISION model.
# Free presets (all no credit card; multi-frame support verified 2026-07):
#   NVIDIA NIM   base https://integrate.api.nvidia.com/v1   key at https://build.nvidia.com  (40 req/min)
#                model: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning (best; 8 frames OK)
#                   or: nvidia/nemotron-nano-12b-v2-vl (3x faster, smaller)
#                avoid: meta/llama-3.2-90b-vision (1 image max), meta/llama-4-maverick + google/gemma-4 (queued/timeout)
#   Groq         no usable vision model as of 2026-08: llama-4-scout/maverick were retired and
#                qwen/qwen3.6-27b caps at 3 images + 8k TPM (3 frames = ~16.5k tokens -> HTTP 413).
#                Its whisper-large-v3 is still free — keep using Groq for WHISPER_API_KEY below.
#   OpenRouter   base https://openrouter.ai/api/v1          key at https://openrouter.ai     (50 req/day)
#                model: any vision model with the :free suffix
#   Ollama local base http://localhost:11434/v1             no key
#                model: qwen3-vl (needs a decent GPU)
OPEN_MODEL_BASE_URL=
OPEN_MODEL_API_KEY=
OPEN_MODEL_ID=
# Optional short name shown in the result badge (defaults to OPEN_MODEL_ID)
# OPEN_MODEL_LABEL=Nemotron 3 Omni
# Optional: cap the reply size. Some endpoints fail on a large max_tokens even
# when they would not generate that much (NVIDIA nemotron-nano-12b-v2-vl 500s at
# the 8192 default). Too low truncates the bilingual report — that model has no
# workable window, so it cannot serve this app.
# OPEN_MODEL_MAX_TOKENS=8192

# Optional: frames sent per analysis (default 8) — lower it for endpoints that cap images
# OPEN_MODEL_MAX_FRAMES=5

# ---- Speech transcript (optional, recommended) ---------------------------
# Open-source Whisper via an OpenAI-compatible /audio/transcriptions endpoint.
# Groq hosts whisper-large-v3 free (2k req/day) — same key as above if you use Groq.
WHISPER_API_KEY=
# WHISPER_BASE_URL=https://api.groq.com/openai/v1
# WHISPER_MODEL=whisper-large-v3

# ---- Gemini (fallback) ----------------------------------------------------
# Free-tier API key (Google account, no credit card): https://aistudio.google.com/apikey
# Leave empty to skip Gemini in the fallback chain.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: absolute paths to ffmpeg/ffprobe if they are not on the server's PATH
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
