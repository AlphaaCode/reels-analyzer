# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# uploaded videos (local cache, never committed)
/public/uploads/

# cached Instagram profile snapshot (videos + stats, personal data)
/public/ig-cache/

# rendered video edits
/exports/

# desktop app build (electron/): its packages, downloaded ffmpeg, staged server, installer
/electron/node_modules/
/electron/.cache/
/electron/stage/
/electron/dist/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# local analysis history + calibration (personal performance data)
/data/

# local Claude Code permissions (per machine)
/.claude/settings.local.json
